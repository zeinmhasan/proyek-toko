generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  CASHIER
  OWNER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QRIS
  OTHER
}

enum FinancialType {
  INCOME
  EXPENSE
}

enum DebtType {
  RECEIVABLE  // Piutang (uang yang akan diterima)
  PAYABLE     // Hutang (uang yang harus dibayar)
}

enum DebtStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

// ==================== MODELS ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  avatar        String?
  role          Role      @default(CASHIER)
  isActive      Boolean   @default(true)
  refreshToken  String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  transactions      Transaction[]
  financialRecords  FinancialRecord[]

  @@index([email])
  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String    @default("#3B82F6")
  icon        String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  products    Product[]

  @@map("categories")
}

model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String?
  price       Decimal   @db.Decimal(12, 2)
  costPrice   Decimal?  @db.Decimal(12, 2)
  stock       Int       @default(0)
  minStock    Int       @default(5)
  unit        String    @default("pcs")
  image       String?
  isActive    Boolean   @default(true)
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  transactionItems  TransactionItem[]

  @@index([sku])
  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model Transaction {
  id              String            @id @default(cuid())
  invoiceNumber   String            @unique
  subtotal        Decimal           @db.Decimal(12, 2)
  discount        Decimal           @default(0) @db.Decimal(12, 2)
  tax             Decimal           @default(0) @db.Decimal(12, 2)
  total           Decimal           @db.Decimal(12, 2)
  paidAmount      Decimal           @db.Decimal(12, 2)
  changeAmount    Decimal           @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod     @default(CASH)
  status          TransactionStatus @default(COMPLETED)
  notes           String?
  customerName    String?
  customerPhone   String?
  
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  items           TransactionItem[]

  @@index([invoiceNumber])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(cuid())
  quantity      Int
  price         Decimal     @db.Decimal(12, 2)
  subtotal      Decimal     @db.Decimal(12, 2)
  
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

model FinancialRecord {
  id          String        @id @default(cuid())
  type        FinancialType
  category    String
  amount      Decimal       @db.Decimal(12, 2)
  description String?
  date        DateTime      @default(now())
  reference   String?
  
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type])
  @@index([date])
  @@index([userId])
  @@map("financial_records")
}

model DebtReceivable {
  id            String      @id @default(cuid())
  type          DebtType
  personName    String
  personPhone   String?
  personAddress String?
  amount        Decimal     @db.Decimal(12, 2)
  paidAmount    Decimal     @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal   @db.Decimal(12, 2)
  dueDate       DateTime?
  status        DebtStatus  @default(PENDING)
  description   String?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  payments      DebtPayment[]

  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@map("debt_receivables")
}

model DebtPayment {
  id              String          @id @default(cuid())
  amount          Decimal         @db.Decimal(12, 2)
  paymentMethod   PaymentMethod   @default(CASH)
  notes           String?
  
  debtReceivableId String
  debtReceivable   DebtReceivable @relation(fields: [debtReceivableId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime        @default(now())

  @@index([debtReceivableId])
  @@map("debt_payments")
}

model StoreSettings {
  id              String    @id @default(cuid())
  name            String    @default("Toko Saya")
  address         String?
  phone           String?
  email           String?
  website         String?
  logo            String?

  // Receipt settings
  receiptHeader   String?
  receiptFooter   String?   @default("Terima kasih atas kunjungan Anda!")
  showLogoOnReceipt   Boolean @default(true)
  showAddressOnReceipt Boolean @default(true)
  showPhoneOnReceipt   Boolean @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("store_settings")
}
